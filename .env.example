# Fargo Unisex Salon & Spa — frontend environment
#
# Copy this file to `.env` and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Settings → API.
#
# The app builds and renders without these (it falls back to sensible
# defaults), but booking, inquiries, and the admin dashboard require a
# live Supabase project to actually store data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side only (Supabase Edge Function: send-notification) ---
# These are NOT exposed to the browser. Set them as Edge Function secrets:
#   Supabase dashboard → Edge Functions → send-notification → Secrets
#
# SUPABASE_URL               provided automatically inside the edge runtime
# SUPABASE_SERVICE_ROLE_KEY  provided automatically inside the edge runtime
# RESEND_API_KEY             optional — enables email notifications via Resend
